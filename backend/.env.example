APP_ENV=development
DATABASE_URL=postgresql://postgres:password@db:5432/studio_booking
SECRET_KEY=change-me-use-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_BASE_URL=http://localhost:8000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Supabase. Used for auth (URL + publishable key) and for DURABLE image storage.
# Uploaded images (staff photos, avatars, room photos) are stored in Supabase
# Storage when SUPABASE_URL + SUPABASE_SERVICE_KEY + a bucket are set — this is
# REQUIRED on Render, whose disk is wiped on every deploy. Without these, uploads
# fall back to local disk (fine for local dev, lost on each Render deploy).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=media
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
PAYMENT_BACKEND=stub
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
SENDGRID_API_KEY=SG.change-me
EMAIL_FROM=ujuperpetua05@gmail.com
EMAIL_REPLY_TO=ujuperpetua05@gmail.com
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ujuperpetua05@gmail.com
SMTP_PASSWORD=change-me-gmail-app-password
SMTP_USE_TLS=true
SUITEDASH_ENABLED=false
SUITEDASH_BASE_URL=https://app.suitedash.com
SUITEDASH_PUBLIC_ID=
SUITEDASH_SECRET_KEY=
SUITEDASH_TIMEOUT_SECONDS=20
SUITEDASH_CONTACT_META_PATH=/contact/meta
SUITEDASH_CONTACT_SYNC_PATH=/contact
SUITEDASH_CONTACT_SYNC_METHOD=POST
SUITEDASH_ROLE_ON_SIGNUP=Lead
SUITEDASH_ROLE_ON_BOOKING=Prospect
SUITEDASH_ROLE_ON_PAID_BOOKING=Client
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWO_FACTOR_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://redis:6379/0
RESERVATION_HOLD_MINUTES=5
CELERY_TASK_ALWAYS_EAGER=false
ALLOW_INLINE_TASKS_IN_PRODUCTION=false
REMINDER_HOURS_BEFORE=24,5,1
REMINDER_DISPATCH_INTERVAL_MINUTES=30
PENDING_BOOKING_CLEANUP_INTERVAL_MINUTES=1
PENDING_BOOKING_EXPIRY_MINUTES=5
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20
